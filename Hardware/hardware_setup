def get_last_session_id():
    """
    Reads the tracking index from the SD card to ensure session
    numbering remains continuous across device reboots.
    Returns:
        int: The last saved session integer index.
    """
    if not sd_available: return 0
    try:
        if "last_session.txt" in os.listdir("/sd"):
            with open("/sd/last_session.txt", "r") as f:
                return int(f.read())
        return 0
    except: return 0

def increment_session_id(current_id):
    """
    Overwrites the persistence tracker on the SD card with the updated session ID.
    Args:
        current_id (int): The active session index to be incremented.
    """
    if not sd_available: return
    try:
        with open("/sd/last_session.txt", "w") as f:
            f.write(str(current_id + 1))
    except: pass

global_session_id = get_last_session_id()
increment_session_id(global_session_id)

