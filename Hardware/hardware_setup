bg_img = sensor.alloc_extra_fb(sensor.width(), sensor.height(), sensor.RGB565)

# ----------------------- IMAGE PROCESSING & AI --------------
def is_valid_target(blob):
    """
    Validates detected movement regions to prevent false edge triggers.
    Filters out background noise using bounding box size limits and
    verifies the target is sufficiently centered inside the viewport frame.
    Args:
        blob (image.blob): MicroPython image blob structure.
    Returns:
        bool: True if properties meet strict hardware filters, False otherwise.
    """
    min_width, max_width  = 40, 200
    min_height, max_height = 40, 180
    if blob.w() < min_width  or blob.w() > max_width:  return False
    if blob.h() < min_height or blob.h() > max_height: return False
    margin = 20
    if blob.x() < margin or (blob.x() + blob.w()) > (320 - margin): return False
    if blob.y() < margin or (blob.y() + blob.h()) > (240 - margin): return False
    return True

def classify_raptor(img, roi):
    """
    Executes an on-device TensorFlow Lite Micro model prediction
    restricted to the localized Region of Interest bounding box.
    Args:
        img (image.Image): Full frame matrix capture.
        roi (tuple): Selected bounding coordinates (x, y, w, h).
    Returns:
        tuple: (Assigned label text string, Floating-point confidence score).
    """
    if net is None:
        return "Model_Missing", 0.0
    print("AI Inference starting...")
    try:
        predictions = net.predict([img], roi=roi)
        output = predictions[0]
        idx = output.index(max(output))
        conf = output[idx]
        print(">>> AI RESULT: %s (%2.1f%%)" % (LABELS[idx], conf * 100))
        return LABELS[idx], conf
    except Exception as e:
        print("Inference failed:", e)
        return "Error", 0.0

# ----------------------- MAIN EXECUTION LOOP ----------------
print("Ready for Urban Bird detection! Waiting for Motion...")
disconnect_wifi()  # Maintain zero-power footprint on startup

while True:
    now = time.time()
    pir_val = pir.value()

    # Hardware Wake-Up Trigger via External Interrupt Line (PIR Low)
    if pir_val == 0:
        if not session_active:
            print(">>> MOTION DETECTED (PIR)")
            session_active = True
            motion_index += 1
            img = sensor.snapshot()
            bg_img.replace(img)
            last_photo_time = now - PHOTO_INTERVAL
        last_motion_time = now

    # Active Session Logic
    if session_active:
        if (now - last_photo_time) >= PHOTO_INTERVAL:

            # 1. Capture frame
            img = sensor.snapshot()

            # 2. Frame differencing — isolate moving regions
            working_img = img.copy()
            working_img.difference(bg_img)
            blobs = working_img.find_blobs([DIFF_THRESHOLD], pixels_threshold=400, merge=True)

            if blobs:
                valid_blobs = [b for b in blobs if is_valid_target(b)]
                if valid_blobs:
                    bird_count = len(valid_blobs)
                    target = max(valid_blobs, key=lambda b: b.pixels())

                    # 3. AI classification on the dominant blob ROI
                    label, confidence = classify_raptor(img, target.rect())
                    last_photo_time = now

                    # 4. Save annotated image to SD card
                    if sd_available:
                        try:
                            t = rtc.datetime()
                            fname = "/sd/S%d_M%d_%s_%02d%02d.jpg" % 
                            (
                                global_session_id, motion_index,
                                label.replace(" ", "_"), t[5], t[6]
                            )
                            img.draw_rectangle(target.rect(), color=(0, 255, 0))
                            img.draw_string
                            (
                                target.x(), target.y() - 12,
                                "%s %d%%" % (label, confidence * 100),
                                color=(0, 255, 0)
                            )
                            img.save(fname, quality=90)
                            print("Saved image to SD: %s" % fname)
                        except Exception as e:
                            print("SD save failed:", e)

                    # 5. Transmit to Supabase if confidence threshold is met
                    if (confidence >= MIN_CONFIDENCE_FOR_ALERT
                            and label != "Error"
                            and label != "Model_Missing"):
                        send_to_supabase(label, bird_count)

        # Close session after inactivity timeout
        if (now - last_motion_time) >= NO_MOTION_TIMEOUT:
            print("Session closed. Waiting for motion...")
            session_active = False

    # Dynamic sleep to optimize power consumption
    time.sleep_ms(100 if not session_active else 10)
