# ----------------------- WIFI FUNCTIONS ---------------------
def connect_wifi():
    """
    Activates the WiFi module and connects to the specified network.
    Monitors connection status with a strict timeout to prevent battery drain.
    Returns:
        bool: True if successfully connected, False otherwise.
    """
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    print("Turning on WiFi...")
    try:
        wlan.connect(WIFI_SSID, WIFI_KEY)
        timeout = 100
        while not wlan.isconnected() and timeout > 0:
            time.sleep_ms(100)
            timeout -= 1
        if wlan.isconnected():
            print("Connected to WiFi! IP:", wlan.ifconfig()[0])
            return True
        else:
            print("WiFi Connection Timeout!")
            return False
    except Exception as e:
        print("WiFi setup failed:", e)
        return False

def disconnect_wifi():
    """
    Disconnects from the WiFi network and deactivates the module
    to maximize energy efficiency and save battery power.
    """
    try:
        wlan = network.WLAN(network.STA_IF)
        wlan.disconnect()
        wlan.active(False)
        print("WiFi disconnected to save battery.")
    except Exception as e:
        pass

# ----------------------- SUPABASE FUNCTION ------------------
def send_to_supabase(label, bird_count):
    """
    Inserts a bird detection record into the Supabase 'Observations' table
    via a raw HTTPS POST to the Supabase REST API over port 443.

    Payload fields match the confirmed working schema:
        - eventtime:     ISO 8601 timestamp from the on-board RTC
        - birds species: Classified bird label (e.g. "Pigeon")
        - location:      Fixed deployment location string from CAMERA_LOCATION
        - amount:        Number of birds detected in this frame

    Args:
        label (str): The classified bird species name.
        bird_count (int): Count of detected birds in the frame.
    """
    if not connect_wifi():
        return

    print("Sending observation to Supabase...")
    s = None
    try:
        # Build timestamp from RTC
        t =         rtc.datetime()
        eventtime = "%04d-%02d-%02dT%02d:%02d:%02d" % (t[0], t[1], t[2], t[4], t[5], t[6])

        # Build payload — column names match Supabase table exactly
        payload = json.dumps
       ({
            "eventtime"    : eventtime,
            "birds species": label,
            "location"     : CAMERA_LOCATION,
            "amount"       : bird_count
        })
        content_length = len(payload)

        # Open TCP + TLS connection to Supabase
        addr = socket.getaddrinfo(SUPABASE_HOST, 443)[0][-1]
        s = socket.socket()
        s.settimeout(10.0)
        s.connect(addr)
        s = ssl.wrap_socket(s, server_hostname=SUPABASE_HOST)

        # Build and send HTTP POST request
        request = 
       (
            "POST /rest/v1/%s HTTP/1.0\r\n"
            "Host: %s\r\n"
            "apikey: %s\r\n"
            "Authorization: Bearer %s\r\n"
            "Content-Type: application/json\r\n"
            "Prefer: return=minimal\r\n"
            "Content-Length: %d\r\n"
            "\r\n"
            "%s"
        ) % (SUPABASE_TABLE, SUPABASE_HOST, SUPABASE_KEY, SUPABASE_KEY, content_length, payload)

        s.send(bytes(request, 'utf8'))
        # Read response status line
        response = b""
        while True:
            try:
                chunk = s.recv(256)
                if not chunk:
                    break
                response += chunk
            except:
                break

        status_line = response.split(b'\r\n')[0].decode('utf-8')
        print(">>> Supabase Reply:", status_line)

        if "201" in status_line:
            print(">>> Observation saved to Supabase! [%s x%d @ %s]" % (label, bird_count, eventtime))
        else:
            print(">>> WARNING: Unexpected response — check table schema / API key.")

    except Exception as e:
        print("Failed to send to Supabase:", e)
    finally:
        if s is not None:
            try: s.close()
            except: pass
        disconnect_wifi()

# ----------------------- SD CARD & RTC SETUP ----------------
sd_available = False
try:
    sd = SDCard()
    os.mount(sd, '/sd')
    print("SD card mounted successfully!")
